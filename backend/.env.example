# Copy this file to backend/.env for local dev. Real values go in Render's
# service → Environment tab when deploying — never commit a filled-in .env.

# Same Supabase project as the frontend and the existing Streamlit app.
SUPABASE_URL=https://your-project-ref.supabase.co
# SERVICE ROLE key, not anon — this backend needs to write on behalf of
# background jobs (PDF generation, email sends) without a browser session.
# Supabase dashboard → Project Settings → API → service_role (secret).
# NEVER expose this key to the frontend or commit it anywhere.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ANON/public key — same value as the frontend's NEXT_PUBLIC_SUPABASE_ANON_KEY,
# not a secret. Used to verify a caller's session token
# (auth.get_user(token)) before running any endpoint that shouldn't be
# publicly reachable — every backend endpoint needs this check from day
# one, see MIGRATION_STATUS.md.
SUPABASE_ANON_KEY=your-anon-public-key

# Resend dashboard → API Keys.
RESEND_API_KEY=re_your_key_here
RESEND_SENDER_EMAIL=onboarding@resend.dev

# Overdue-collection-alert recipients (POST /email/collection-overdue).
# Each slot may itself be a comma-separated list. Falls back to real MD/FM
# addresses in code if both are unset — see app/email.py.
NOTIFY_EMAIL_1=
NOTIFY_EMAIL_2=

# Comma-separated list of frontend origins allowed to call this API.
# Local dev + your deployed frontend subdomain once you have one.
ALLOWED_ORIGINS=http://localhost:3000,https://beta.appointedtime.com
